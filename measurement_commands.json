{
  "spark": [
    "docker",
    "run",
    "--rm",
    "--name",
    "a3-spark-driver",
    "--hostname",
    "a3-spark-driver",
    "--network",
    "a3-network",
    "--memory",
    "2g",
    "--memory-swap",
    "2g",
    "--cpus",
    "1",
    "--tmpfs",
    "/tmp:rw,exec,size=128m",
    "--log-opt",
    "max-size=10m",
    "--log-opt",
    "max-file=2",
    "-p",
    "127.0.0.1:4040:4040",
    "--mount",
    "type=bind,source={code_dir},target=/opt/assignment,readonly",
    "--mount",
    "type=bind,source=/run/media/arnav/ESD-USB/assignment3/data,target=/opt/spark-data",
    "-e",
    "A3_MODE=million",
    "-e",
    "A3_RUN_TAG={tag}",
    "--entrypoint",
    "/opt/spark/bin/spark-submit",
    "cluster-apache-spark:3.3.4",
    "--master",
    "spark://a3-spark-master:7077",
    "--driver-memory",
    "1g",
    "--executor-memory",
    "512m",
    "--conf",
    "spark.driver.host=a3-spark-driver",
    "--conf",
    "spark.executor.cores=1",
    "--conf",
    "spark.local.dir=/opt/spark-data/spark-scratch/driver",
    "--total-executor-cores",
    "2",
    "/opt/assignment/spark_clean.py"
  ],
  "ray": [
    "docker",
    "exec",
    "-i",
    "-e",
    "A3_MODE=million",
    "-e",
    "A3_RUN_TAG={tag}",
    "a3-ray-head",
    "/home/arnav/miniforge3/envs/aiops/bin/python",
    "-u",
    "-"
  ]
}
